+    XCTAssertTrue(document.string.hasPrefix("before\n"))
+    XCTAssertTrue(document.string.hasSuffix("\nafter"))
+    XCTAssertNotNil(document.attribute(.attachment, at: 7, effectiveRange: nil))
+  }
